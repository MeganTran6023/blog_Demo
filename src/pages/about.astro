---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostDirectory from '../components/PostDirectory.astro';
import { SITE_DESCRIPTION } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// ONLY SHOW MUSIC EDUCATION POSTS
const musicPosts = allPosts.filter(post => post.data.category === 'Music Education');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Music Education" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<PostDirectory heading="Music Education" posts={musicPosts} />
		</main>
		<Footer />
	</body>
</html>