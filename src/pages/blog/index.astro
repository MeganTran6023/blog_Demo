---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostDirectory from '../../components/PostDirectory.astro';
import { SITE_DESCRIPTION } from '../../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// ONLY SHOW Programming POSTS
const programmingPosts = allPosts.filter(post => post.data.category === 'Programming');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Programming" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<PostDirectory heading="Programming" posts={programmingPosts} />
		</main>
		<Footer />
	</body>
</html>